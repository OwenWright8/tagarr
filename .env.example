# NOTHING IN THIS FILE IS REQUIRED.
#
# Tagarr is configured in its web UI (Jellyfin, Seerr, people, rules).
# Docker Compose reads a file named `.env` next to docker-compose.yml
# automatically: copy this to `.env` and uncomment what you want to change.

# --- Port ---------------------------------------------------------------------
# The port the app is published on (host side). Default 8686.
# APP_PORT=8686

# --- Update reminder ----------------------------------------------------------
# Every 12 hours the server asks GitHub for the latest release (one anonymous
# GET of a public URL; nothing about you is sent) and the app shows a
# dismissible "new version available" note. Browsers never contact GitHub.
# UPDATE_CHECK=on             # "off" for no requests and no reminder

# --- Time zone (for log timestamps) -------------------------------------------
# TZ=America/Indiana/Indianapolis

# --- Pin the version ----------------------------------------------------------
# Defaults to the latest release. Set a tag (e.g. v1.0.0), or a minor series
# (e.g. 1.0, which still gets bug-fix releases), to control when upgrades happen.
# TAGARR_VERSION=latest
