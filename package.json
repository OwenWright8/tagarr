{
  "name": "autotagarr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Automatic per-person tags for a shared Jellyfin library, driven by Seerr requests",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.ts",
    "dev:web": "vite",
    "dev:mock": "node scripts/mock-servers.ts",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.3.2"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@tanstack/react-query": "^5.83.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.462.0",
    "playwright": "1.57.0",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^5.4.19"
  }
}
